<Window x:Class="JaTelei.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Resources/app.ico" Title="Ja Telei" Height="560" Width="820"
        Background="#000000" WindowStyle="None"
        ResizeMode="CanResize"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="5"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#1E1E1E" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Barra de título ───────────────────────────────────── -->
            <Border Grid.Row="0" Background="#000000">
                <Border.BorderBrush>
                    <SolidColorBrush Color="#1A1A1A"/>
                </Border.BorderBrush>
                <Border.BorderThickness>0,0,0,1</Border.BorderThickness>
                <Grid>
                    <!-- Logo + nome -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <Ellipse Width="8" Height="8" Fill="#3B82F6" Margin="0,0,7,0"/>
                        <TextBlock Text="Ja Telei"
                                   Foreground="#888888"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Botões de janela -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="─"
                                Style="{StaticResource BtnChrome}"
                                Click="Minimize_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="✕"
                                Style="{StaticResource BtnChromeClose}"
                                Click="Close_Click"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Banner de atualização ─────────────────────────────── -->
            <Border Grid.Row="1" x:Name="UpdateBanner"
                    Background="#0D0D0D"
                    Visibility="Collapsed"
                    Padding="14,9">
                <Border.BorderBrush>
                    <SolidColorBrush Color="#1A1A1A"/>
                </Border.BorderBrush>
                <Border.BorderThickness>0,0,0,1</Border.BorderThickness>
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            x:Name="UpdateButton"
                            Content="Atualizar agora"
                            Style="{StaticResource BtnPrimary}"
                            Padding="12,5"
                            Click="UpdateButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#3B82F6" Margin="0,0,8,0"/>
                        <TextBlock x:Name="UpdateText"
                                   Text="Nova versão disponível!"
                                   Foreground="#888888"
                                   FontSize="12"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── Conteúdo principal ────────────────────────────────── -->
            <ContentControl Grid.Row="2" x:Name="MainContent"/>
        </Grid>
    </Border>
</Window>
