<Window x:Class="JaTelei.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ja Telei" Height="560" Width="820"
        Background="#181825" WindowStyle="None"
        ResizeMode="CanResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="5"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de título customizada -->
        <Border Grid.Row="0" Background="#11111b">
            <Grid>
                <TextBlock Text="Ja Telei" Foreground="#cdd6f4"
                           VerticalAlignment="Center" Margin="12,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="─" Click="Minimize_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="46" Height="32" Background="Transparent"
                            BorderThickness="0" Foreground="White"/>
                    <Button Content="✕" Click="Close_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="46" Height="32" Background="Transparent"
                            BorderThickness="0" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barra de update (oculta por padrão) -->
        <Border Grid.Row="1" x:Name="UpdateBanner" Background="#313244"
                Visibility="Collapsed" Padding="12,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="UpdateButton"
                        Content="Atualizar agora" Click="UpdateButton_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Background="#89b4fa" Foreground="#1e1e2e"
                        BorderThickness="0" Padding="12,4" FontWeight="SemiBold"/>
                <TextBlock x:Name="UpdateText" Foreground="#cdd6f4"
                           VerticalAlignment="Center"
                           Text="Nova versão disponível!"/>
            </DockPanel>
        </Border>

        <!-- Conteúdo principal -->
        <ContentControl Grid.Row="2" x:Name="MainContent"/>
    </Grid>
</Window>
