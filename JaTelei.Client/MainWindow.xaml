<Window x:Class="JaTelei.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Resources/app.ico"
        Title="JaTelei"
        Height="760" Width="1280"
        MinHeight="680" MinWidth="1120"
        Background="#0B1114"
        WindowStyle="None"
        ResizeMode="CanResize"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="5"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#203036" BorderThickness="1" x:Name="RootBorder" Background="#0B1114">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0D1519" BorderBrush="#1D2A2F" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <Border Width="14" Height="14" BorderBrush="#24E0B6" BorderThickness="1.5" CornerRadius="3" Margin="0,0,8,0">
                            <Border Width="7" Height="7" Background="#1DBFCE" CornerRadius="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"/>
                        </Border>
                        <TextBlock Text="JaTelei" Foreground="#C9D3D5" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="-" Style="{StaticResource BtnChrome}" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimizar"/>
                        <Button x:Name="BtnMaxRestore" Content="□" Style="{StaticResource BtnChrome}" Click="MaxRestore_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximizar"/>
                        <Button Content="X" Style="{StaticResource BtnChromeClose}" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Fechar"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" x:Name="UpdateBanner" Background="#102D28" Visibility="Collapsed" Padding="14,9" BorderBrush="#1E8F75" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" x:Name="UpdateButton" Content="Atualizar agora" Style="{StaticResource BtnPrimary}" Padding="12,5" Click="UpdateButton_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#28E4B0" Margin="0,0,8,0"/>
                        <TextBlock x:Name="UpdateText" Text="Nova versao disponivel!" Foreground="#D7FFEF" FontSize="12"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="2" x:Name="MainContent"/>
        </Grid>
    </Border>
</Window>
