<Window x:Class="JaTelei.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Resources/app.ico"
        Title="JaTelei"
        Height="760" Width="1280"
        MinHeight="680" MinWidth="1120"
        Background="#0B1114"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="5"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#203036" BorderThickness="1" x:Name="RootBorder" Background="#0B1114">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0D1519" BorderBrush="#1D2A2F" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <Image Source="Resources/app.ico" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="JaTelei" Foreground="#C9D3D5" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="&#xE921;" Style="{StaticResource BtnChrome}" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimizar"/>
                        <Button x:Name="BtnMaxRestore" Content="&#xE922;" Style="{StaticResource BtnChrome}" Click="MaxRestore_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximizar"/>
                        <Button Content="&#xE8BB;" Style="{StaticResource BtnChromeClose}" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Fechar"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" x:Name="MainContent"/>

            <Grid Grid.Row="1" x:Name="UpdateBanner" Visibility="Collapsed" Background="#99000000">
                <Border Width="440" MaxWidth="440" Background="#FF0D1519" BorderBrush="#FF243136" BorderThickness="1" CornerRadius="8" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <Border Width="54" Height="54" CornerRadius="14" Background="#182D29" BorderBrush="#22D3A6" BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,0,18">
                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" Foreground="#35E6BA" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Atualização disponível" Foreground="#FFFFFF" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="UpdateText" Text="Uma nova versão do JaTelei está pronta." Foreground="#C9D3D5" FontSize="13" LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,22"/>
                        <Border Background="#0A1114" BorderBrush="#223238" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,0,22">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#28E49F" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Recomendado para receber correções de vídeo, áudio e estabilidade." Foreground="#9FB0B5" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="UpdateLaterButton" Content="Depois" Style="{StaticResource BtnSecondary}" Padding="18,9" MinWidth="94" Margin="0,0,10,0" Click="UpdateLaterButton_Click"/>
                            <Button x:Name="UpdateButton" Content="Atualizar agora" Style="{StaticResource BtnPrimary}" Padding="18,9" MinWidth="148" Click="UpdateButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
