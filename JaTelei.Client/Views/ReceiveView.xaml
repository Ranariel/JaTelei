<UserControl x:Class="JaTelei.Client.Views.ReceiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <Grid Background="#000000">

        <!-- ── Vídeo — ocupa toda a área ──────────────────────────── -->
        <Image Source="{Binding Frame}"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="LowQuality"
               VerticalAlignment="Stretch"
               HorizontalAlignment="Stretch"/>

        <!-- ── Overlay superior direito: estado da conexão ──────── -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                Margin="12" Padding="9,5"
                Background="#B3000000" CornerRadius="8">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="6" Height="6"
                         VerticalAlignment="Center" Margin="0,0,7,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#52C87E"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                    <Setter Property="Fill" Value="#888888"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="#888888"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ── Barra inferior: controles do player ──────────────── -->
        <Border VerticalAlignment="Bottom"
                Background="#CC000000"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Esquerda: resolução recebida -->
                <TextBlock Grid.Column="0"
                           Text="{Binding DimensionsText}"
                           Foreground="#555555" FontSize="11"
                           VerticalAlignment="Center"/>

                <!-- Centro: mute + slider de volume -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <!-- Botão silenciar / ativar áudio -->
                    <Button Command="{Binding ToggleMuteCommand}"
                            Style="{StaticResource BtnGhost}"
                            Padding="6,4" FontSize="15"
                            Margin="0,0,8,0"
                            ToolTip="Silenciar / ativar áudio">
                        <TextBlock Text="{Binding MuteIcon}"/>
                    </Button>

                    <!-- Slider de volume 0-100 -->
                    <Slider Width="120" Minimum="0" Maximum="100"
                            Value="{Binding Volume, Mode=TwoWay}"
                            Style="{StaticResource VolumeSlider}"
                            VerticalAlignment="Center"
                            ToolTip="Volume"/>

                    <!-- Percentual numérico -->
                    <TextBlock Text="{Binding Volume, StringFormat='{}{0:0}%'}"
                               Foreground="#555555" FontSize="10"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" Width="32"/>
                </StackPanel>

                <!-- Direita: botão parar -->
                <Button Grid.Column="2"
                        Content="Parar"
                        Command="{Binding StopCommand}"
                        Style="{StaticResource BtnSecondary}"
                        Padding="14,6" FontSize="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</UserControl>
