<UserControl x:Class="JaTelei.Client.Views.ReceiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <Grid Background="#000000">

        <!-- Vídeo -->
        <Image Source="{Binding Frame}"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="LowQuality"/>

        <!-- Overlay superior -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                Margin="12" Padding="10,6"
                Background="#B3000000"
                CornerRadius="8">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="#52C87E"
                         VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="#888888"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0"/>
                <Button Content="Parar"
                        Command="{Binding StopCommand}"
                        Style="{StaticResource BtnSecondary}"
                        Padding="10,4"
                        FontSize="12"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
