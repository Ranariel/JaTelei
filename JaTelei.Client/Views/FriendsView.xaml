<UserControl x:Class="JaTelei.Client.Views.FriendsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B1114"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C8D1D3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#182529"/>
                                <Setter Property="Foreground" Value="#F4FAFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#121B1F"/>
            <Setter Property="BorderBrush" Value="#243136"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#EEF5F5"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#EEF5F5"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="10,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#172327"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12332D"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#22D3A6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Background="#0B1114">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0D1519" BorderBrush="#1D2A2F" BorderThickness="0,0,1,0">
            <DockPanel Margin="14">
                <Button DockPanel.Dock="Bottom" Command="{Binding LogoutCommand}" Style="{StaticResource BtnSecondary}" Padding="12,9" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Sair" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,26">
                        <Border Width="34" Height="34" BorderBrush="#24E0B6" BorderThickness="2" CornerRadius="6" Margin="0,0,10,0">
                            <Border Width="18" Height="18" Background="#1DBFCE" CornerRadius="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5"/>
                        </Border>
                        <TextBlock Text="JaTelei" Foreground="#F6FBFB" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Margin="0,0,0,8" Command="{Binding ShowShareCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsShareSection}" Value="True">
                                        <Setter Property="Background" Value="#143530"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="32"/>
                            <TextBlock Text="Compartilhar" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="0,0,0,8" Command="{Binding ShowSessionCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSessionSection}" Value="True">
                                        <Setter Property="Background" Value="#143530"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="32"/>
                            <TextBlock Text="Sessao" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="0,0,0,8" Command="{Binding ShowDevicesCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDevicesSection}" Value="True">
                                        <Setter Property="Background" Value="#143530"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE772;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="32"/>
                            <TextBlock Text="Dispositivos" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowSettingsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsSection}" Value="True">
                                        <Setter Property="Background" Value="#143530"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="32"/>
                            <TextBlock Text="Configuracoes" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="2,0,2,4">
                    <TextBlock Text="JaTelei" Foreground="#B8C2C4" FontSize="12"/>
                    <TextBlock Text="Compartilhe sua tela." Foreground="#7F8D91" FontSize="11" Margin="0,4,0,0"/>
                    <TextBlock Text="De forma simples." Foreground="#7F8D91" FontSize="11"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="92"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#10191D" BorderBrush="#1F2E34" BorderThickness="0,0,0,1" Padding="22,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Sala " Foreground="#C4CED1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,4,8,0"/>
                        <TextBlock Text="{Binding SessionCode}" Foreground="#FFFFFF" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding CopyInviteCommand}" Style="{StaticResource BtnSecondary}" Padding="14,8" Margin="22,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,8,0"/>
                            <TextBlock Text="Copiar convite"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#102D28" BorderBrush="#1E8F75" BorderThickness="1" CornerRadius="8" Padding="13,8" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="#28E49F" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SharingStatus}" Foreground="#58F0C3" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding LatencyLabel}" Foreground="#F6D36A" FontSize="13" Margin="0,0,18,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding UploadLabel}" Foreground="#F4FAFA" FontSize="13" Margin="0,0,18,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FrameRateLabel}" Foreground="#F4FAFA" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="22,18,22,96" Visibility="{Binding IsShareSection, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="326"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="56"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Panel}" ClipToBounds="True" Margin="0,0,14,14">
                    <Grid Background="#071116">
                        <Image Source="{Binding SelfPreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/>
                        <Grid Visibility="{Binding SelfPreviewImage, Converter={StaticResource NullToVis}}">
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#071116" Offset="0"/>
                                    <GradientStop Color="#10232A" Offset="0.48"/>
                                    <GradientStop Color="#081014" Offset="1"/>
                                </LinearGradientBrush>
                            </Grid.Background>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" Foreground="#28E4B0" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                                <TextBlock Text="{Binding SharingStatus}" Foreground="#FFFFFF" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/>
                                <TextBlock Text="{Binding PreviewHint}" Foreground="#AAB7BA" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Border Background="#CC10191D" BorderBrush="#26383F" BorderThickness="1" CornerRadius="7" Padding="12,9" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14">
                            <TextBlock Text="{Binding PreviewHint}" Foreground="#FFFFFF" FontSize="13"/>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.0*"/>
                        <ColumnDefinition Width="1.0*"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="1.15*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding ShareScreenCommand}" Style="{StaticResource ActionButton}" Background="#0D7D63" BorderBrush="#20D5A6" Foreground="#FFFFFF" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="22" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding ShareActionText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Command="{Binding TogglePauseCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="20" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding PauseActionText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Command="{Binding CopyInviteCommand}" Style="{StaticResource ActionButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Copiar convite" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Command="{Binding StopShareCommand}" Style="{StaticResource ActionButton}" Background="#3A1519" BorderBrush="#E05252" Foreground="#FFD6D6">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Parar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <ScrollViewer Grid.RowSpan="2" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource Panel}" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Destino do compartilhamento" Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Tag="Apelido do contato" Text="{Binding AddUsername, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Height="42" Padding="11,0"/>
                                    <Button Grid.Column="1" Command="{Binding AddFriendCommand}" Style="{StaticResource BtnPrimary}" Padding="0" Margin="6,0,0,0">
                                        <TextBlock Text="+" FontSize="18" FontWeight="SemiBold"/>
                                    </Button>
                                </Grid>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="#58F0C3" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding PendingRequests}" Visibility="{Binding PendingRequests.Count, Converter={StaticResource CountToVis}}" Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#10191D" BorderBrush="#2A3940" BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Username}" Foreground="#FFFFFF" FontSize="12"/>
                                                        <TextBlock Text="quer se conectar" Foreground="#9CABAF" FontSize="11"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="Aceitar" Command="{Binding DataContext.AcceptRequestCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnPrimary}" Padding="9,5" FontSize="11"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ListBox ItemsSource="{Binding Friends}" SelectedItem="{Binding SelectedFriend}" MaxHeight="132">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#445056"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                    <Setter Property="Fill" Value="#28E4B0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Grid.Column="1" Text="{Binding Username}" Foreground="#EEF5F5" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="Selecionar" Foreground="#7F8D91" FontSize="11" Margin="8,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Panel}" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="Quem esta vendo" Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ViewerCountText}" Foreground="#58F0C3" FontSize="13" HorizontalAlignment="Right"/>
                                </Grid>
                                <Border Background="#10191D" BorderBrush="#2A3940" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ViewerStatus}" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ViewerDetail}" Foreground="#9CABAF" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Panel}" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Audio do sistema" Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <CheckBox IsChecked="{Binding IncludeSystemAudio}" Foreground="#C9D3D5" FontSize="13" Content="Incluir audio do sistema na transmissao"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Panel}" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Conexao" Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock Text="Servidor conectado" Foreground="#58F0C3" FontSize="13"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Qualidade " Foreground="#C9D3D5" FontSize="12"/>
                                    <TextBlock Text="{Binding QualityLabel}" Foreground="#C9D3D5" FontSize="12"/>
                                    <TextBlock Text=" / " Foreground="#C9D3D5" FontSize="12"/>
                                    <TextBlock Text="{Binding FrameRateLabel}" Foreground="#C9D3D5" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Bitrate alvo " Foreground="#9CABAF" FontSize="12"/>
                                    <TextBlock Text="{Binding TargetBitrateLabel}" Foreground="#9CABAF" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding EncoderBitrateLabel}" Foreground="#9CABAF" FontSize="12"/>
                                    <TextBlock Text="  " Foreground="#9CABAF" FontSize="12"/>
                                    <TextBlock Text="{Binding PacketLossLabel}" Foreground="#9CABAF" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="1" Margin="22" Visibility="{Binding IsSessionSection, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource Panel}" Padding="26">
                    <StackPanel MaxWidth="680">
                        <TextBlock Text="Sessao" Foreground="#FFFFFF" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="Gerencie o convite e acompanhe o estado da transmissao." Foreground="#9CABAF" FontSize="14" Margin="0,8,0,24"/>
                        <TextBlock Text="Link da sessao" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding SessionLink}" IsReadOnly="True" Margin="0,8,0,14"/>
                        <Button Command="{Binding CopyInviteCommand}" Style="{StaticResource BtnPrimary}" Padding="18,10" HorizontalAlignment="Left" Content="Copiar convite"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="22" Visibility="{Binding IsDevicesSection, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource Panel}" Padding="26">
                    <StackPanel MaxWidth="720">
                        <TextBlock Text="Dispositivos" Foreground="#FFFFFF" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="Preferencias usadas ao iniciar uma transmissao." Foreground="#9CABAF" FontSize="14" Margin="0,8,0,24"/>
                        <CheckBox IsChecked="{Binding IncludeSystemAudio}" Foreground="#C9D3D5" FontSize="14" Content="Incluir audio do sistema"/>
                        <TextBlock Text="A tela ou janela ainda e escolhida no momento de iniciar o compartilhamento." Foreground="#9CABAF" FontSize="13" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="22" Visibility="{Binding IsSettingsSection, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource Panel}" Padding="26">
                    <StackPanel MaxWidth="760">
                        <TextBlock Text="Configuracoes" Foreground="#FFFFFF" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="Ajustes basicos do aplicativo e da experiencia de compartilhamento." Foreground="#9CABAF" FontSize="14" Margin="0,8,0,24"/>
                        <UniformGrid Rows="1" Columns="2">
                            <Border Background="#10191D" BorderBrush="#2A3940" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Atualizacoes" Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="O JaTelei verifica novas versoes automaticamente." Foreground="#9CABAF" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,0"/>
                                    <TextBlock Text="Status: atualizado" Foreground="#58F0C3" FontSize="13" Margin="0,14,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#10191D" BorderBrush="#2A3940" BorderThickness="1" CornerRadius="8" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Compartilhamento" Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold"/>
                                    <CheckBox IsChecked="{Binding IncludeSystemAudio}" Foreground="#C9D3D5" FontSize="13" Content="Incluir audio do sistema por padrao" Margin="0,10,0,0"/>
                                    <TextBlock Foreground="#9CABAF" FontSize="13" Margin="0,12,0,0"><Run Text="Qualidade atual: "/><Run Text="{Binding QualityLabel}"/><Run Text=" / "/><Run Text="{Binding FrameRateLabel}"/></TextBlock>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
