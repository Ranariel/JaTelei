<UserControl x:Class="JaTelei.Client.Views.FriendsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#000000"
             FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Sidebar esquerda ──────────────────────────────────────── -->
        <Border Grid.Column="0"
                Background="#000000"
                BorderBrush="#1A1A1A"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Cabeçalho da sidebar -->
                <Border DockPanel.Dock="Top"
                        Padding="14,14,14,10"
                        BorderBrush="#1A1A1A"
                        BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="Amigos"
                                   Foreground="#F0F0F0"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>
                        <!-- Add friend -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Tag="Apelido do amigo"
                                     Text="{Binding AddUsername, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12"
                                     Padding="8,6"/>
                            <Button Grid.Column="1" Margin="6,0,0,0"
                                    Width="32" Height="32"
                                    Style="{StaticResource BtnPrimary}"
                                    Padding="0"
                                    FontSize="16" FontWeight="Bold"
                                    Command="{Binding AddFriendCommand}">
                                <TextBlock Text="+" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="#52C87E"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NotNullToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- Pedidos pendentes -->
                <ItemsControl DockPanel.Dock="Top"
                              ItemsSource="{Binding PendingRequests}"
                              Visibility="{Binding PendingRequests.Count, Converter={StaticResource CountToVis}}"
                              Margin="10,10,10,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0D0D0D"
                                    BorderBrush="#2A2A2A"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,2"
                                    Padding="10,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Username}"
                                                   Foreground="#F0F0F0"
                                                   FontSize="12"/>
                                        <TextBlock Text="pedido de amizade"
                                                   Foreground="#888888"
                                                   FontSize="10"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Aceitar"
                                            Style="{StaticResource BtnPrimary}"
                                            Padding="8,4"
                                            FontSize="11"
                                            Command="{Binding DataContext.AcceptRequestCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Lista de amigos -->
                <ListBox ItemsSource="{Binding Friends}"
                         SelectedItem="{Binding SelectedFriend}"
                         Margin="6,8,6,6">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2,1">
                                <!-- Indicador online/offline -->
                                <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#333333"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                    <Setter Property="Fill" Value="#52C87E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding Username}"
                                           Foreground="#F0F0F0"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </DockPanel>
        </Border>

        <!-- ── Painel direito ─────────────────────────────────────────── -->
        <Grid Grid.Column="1" Background="#000000">

            <!-- Estado vazio: nenhum amigo selecionado -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding SelectedFriend, Converter={StaticResource NullToVis}}">
                <!-- Ícone decorativo -->
                <Border Width="52" Height="52"
                        Background="#0D0D0D"
                        BorderBrush="#2A2A2A"
                        BorderThickness="1"
                        CornerRadius="16"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,14">
                    <TextBlock Text="📺" FontSize="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Selecione um amigo"
                           Foreground="#F0F0F0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>
                <TextBlock Text="para compartilhar a tela"
                           Foreground="#888888"
                           FontSize="12"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Estado: amigo selecionado -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding SelectedFriend, Converter={StaticResource NotNullToVis}}">
                <Border Width="52" Height="52"
                        Background="#0F1A2E"
                        BorderBrush="#3B82F6"
                        BorderThickness="1"
                        CornerRadius="16"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,14">
                    <TextBlock Text="📺" FontSize="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock FontSize="14" Foreground="#F0F0F0"
                           TextAlignment="Center" Margin="0,0,0,4">
                    <Run Text="Compartilhar com "/>
                    <Run Text="{Binding SelectedFriend.Username}" FontWeight="Bold" Foreground="#3B82F6"/>
                </TextBlock>
                <TextBlock Text="A sessão começa quando o amigo aceitar"
                           Foreground="#888888"
                           FontSize="11"
                           TextAlignment="Center"
                           Margin="0,0,0,20"/>
                <Button Content="Iniciar compartilhamento"
                        Command="{Binding ShareScreenCommand}"
                        Style="{StaticResource BtnPrimary}"
                        Padding="20,10"
                        FontSize="13"
                        HorizontalAlignment="Center"/>
            </StackPanel>

        </Grid>
    </Grid>
</UserControl>
