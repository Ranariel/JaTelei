<UserControl x:Class="JaTelei.Client.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JaTelei.Client.ViewModels"
             Background="#000000"
             FontFamily="Segoe UI">

    <Grid>
        <!-- Glow decorativo no centro -->
        <Ellipse Width="320" Height="320"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#0A3B82F6" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Formulário -->
        <Border MaxWidth="320"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Background="#0D0D0D"
                BorderBrush="#2A2A2A"
                BorderThickness="1"
                CornerRadius="14"
                Padding="28,32">
            <StackPanel>

                <!-- Logo / Brand -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,28">
                    <Ellipse Width="36" Height="36"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,10">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="#3B82F6"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="Ja Telei"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#F0F0F0"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Compartilhe sua tela"
                               FontSize="12"
                               Foreground="#888888"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Apelido (só no registro) -->
                <TextBox Margin="0,0,0,10"
                         Tag="Apelido (ex: gamer123)"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}"/>

                <!-- Email -->
                <TextBox Margin="0,0,0,10"
                         Tag="Email"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Senha -->
                <PasswordBox Margin="0,0,0,4"
                             x:Name="PwdBox"/>

                <!-- Erro -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#E05252"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}"/>

                <!-- Botão principal -->
                <Button Margin="0,16,0,0"
                        Padding="0,11"
                        Style="{StaticResource BtnPrimary}"
                        Command="{Binding SubmitCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}">
                    <TextBlock Text="{Binding IsRegisterMode, Converter={StaticResource BoolToLoginRegister}}"
                               FontSize="13"/>
                </Button>

                <!-- Separador -->
                <Border Height="1" Background="#1A1A1A" Margin="0,16"/>

                <!-- Alternar modo -->
                <Button Command="{Binding ToggleModeCommand}"
                        Style="{StaticResource BtnGhost}"
                        HorizontalAlignment="Center">
                    <TextBlock FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Não tem conta? Criar agora"/>
                                <Setter Property="Foreground" Value="#888888"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                                        <Setter Property="Text" Value="Já tem conta? Entrar"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
