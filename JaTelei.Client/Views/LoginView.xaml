<UserControl x:Class="JaTelei.Client.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JaTelei.Client.ViewModels"
             Background="#1e1e2e">
    <Grid MaxWidth="340" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Ja Telei" FontSize="28" FontWeight="Bold"
                   Foreground="#cdd6f4"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBox Grid.Row="1" Margin="0,4"
                 Tag="Apelido (ex: gamer123)"
                 Background="#313244" Foreground="#cdd6f4" CaretBrush="White"
                 BorderBrush="#45475a" Padding="8,6"
                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                 Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}"/>

        <TextBox Grid.Row="2" Margin="0,4"
                 Tag="Email"
                 Background="#313244" Foreground="#cdd6f4" CaretBrush="White"
                 BorderBrush="#45475a" Padding="8,6"
                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

        <PasswordBox Grid.Row="3" Margin="0,4"
                     Background="#313244" Foreground="#cdd6f4" CaretBrush="White"
                     BorderBrush="#45475a" Padding="8,6"
                     x:Name="PwdBox"/>

        <TextBlock Grid.Row="4" Text="{Binding ErrorMessage}"
                   Foreground="#f38ba8" Margin="0,4" TextWrapping="Wrap"/>

        <Button Grid.Row="5" Margin="0,8" Padding="0,10"
                Background="#89b4fa" Foreground="#1e1e2e" FontWeight="SemiBold"
                BorderThickness="0"
                Command="{Binding SubmitCommand}"
                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}">
            <TextBlock Text="{Binding IsRegisterMode, Converter={StaticResource BoolToLoginRegister}}"/>
        </Button>

        <Button Grid.Row="6" Command="{Binding ToggleModeCommand}"
                Background="Transparent" BorderThickness="0">
            <TextBlock Foreground="#6c7086">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Nao tem conta? Criar agora"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                                <Setter Property="Text" Value="Ja tem conta? Entrar"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Button>
    </Grid>
</UserControl>
