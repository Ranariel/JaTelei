<Window x:Class="JaTelei.Client.Views.SharePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar Compartilhamento"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#000000"
        Foreground="#F0F0F0"
        FontFamily="Segoe UI"
        WindowStyle="None">

    <Window.Resources>

        <!-- Tipo de captura (Tela / Janela / Jogo) -->
        <Style x:Key="TypeBtn" TargetType="Button">
            <Setter Property="Background"     Value="#0D0D0D"/>
            <Setter Property="Foreground"     Value="#888888"/>
            <Setter Property="BorderBrush"    Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width"          Value="128"/>
            <Setter Property="Height"         Value="86"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="Bd" Property="Background"  Value="#0F1A2E"/>
                                <Setter Property="Foreground" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TypeBtnSelected" TargetType="Button" BasedOn="{StaticResource TypeBtn}">
            <Setter Property="Background"  Value="#0F1A2E"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="Foreground"  Value="#F0F0F0"/>
        </Style>

        <!-- Botão de FPS -->
        <Style x:Key="FpsBtn" TargetType="Button">
            <Setter Property="Background"     Value="#0D0D0D"/>
            <Setter Property="Foreground"     Value="#888888"/>
            <Setter Property="BorderBrush"    Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"        Value="0"/>
            <Setter Property="Height"         Value="34"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="FontWeight"     Value="SemiBold"/>
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="Bd" Property="Background"  Value="#0F1A2E"/>
                                <Setter Property="Foreground" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FpsBtnSelected" TargetType="Button" BasedOn="{StaticResource FpsBtn}">
            <Setter Property="Background"  Value="#0F1A2E"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="Foreground"  Value="#3B82F6"/>
        </Style>

        <!-- Item da lista (janelas/monitores) -->
        <Style x:Key="ListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground"     Value="#F0F0F0"/>
            <Setter Property="Background"     Value="Transparent"/>
            <Setter Property="Padding"        Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Margin="0,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0D0D0D"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F1A2E"/>
                                <Setter Property="Foreground" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Borda externa da janela -->
    <Border BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="12">
        <StackPanel Margin="24">

            <!-- Título da janela + fechar -->
            <Grid Margin="0,0,0,20">
                <TextBlock Text="O que deseja compartilhar?"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#F0F0F0"
                           VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right"
                        Content="✕"
                        Style="{StaticResource BtnGhost}"
                        Padding="6,4"
                        FontSize="13"
                        Click="Cancel_Click"/>
            </Grid>

            <!-- Opções de tipo -->
            <UniformGrid Rows="1" Columns="3">
                <Button x:Name="BtnTela" Style="{StaticResource TypeBtn}"
                        Margin="0,0,8,0" Click="BtnTela_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🖥️" FontSize="26" HorizontalAlignment="Center"/>
                        <TextBlock Text="Tela" Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="12" FontWeight="Medium"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnJanela" Style="{StaticResource TypeBtn}"
                        Margin="4,0" Click="BtnJanela_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🪟" FontSize="26" HorizontalAlignment="Center"/>
                        <TextBlock Text="Janela" Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="12" FontWeight="Medium"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnJogo" Style="{StaticResource TypeBtn}"
                        Margin="8,0,0,0" Click="BtnJogo_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🎮" FontSize="26" HorizontalAlignment="Center"/>
                        <TextBlock Text="Jogo" Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="12" FontWeight="Medium"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Lista de seleção -->
            <Border x:Name="ListPanel" Visibility="Collapsed"
                    Background="#0A0A0A"
                    BorderBrush="#2A2A2A" BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,16,0,0" Padding="12">
                <StackPanel>
                    <TextBlock x:Name="ListLabel"
                               Text="Selecione a janela:"
                               Foreground="#888888"
                               FontSize="11"
                               Margin="2,0,0,8"/>
                    <ListBox x:Name="ItemsList"
                             MaxHeight="180"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource ListItemStyle}"
                             SelectionChanged="ItemsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Configurações de qualidade -->
            <Border x:Name="QualityPanel" Visibility="Collapsed"
                    Background="#0A0A0A"
                    BorderBrush="#2A2A2A" BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,16,0,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="Qualidade"
                               Foreground="#888888"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14"/>

                    <!-- Resolução -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Resolução"
                                   Foreground="#F0F0F0"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="CboResolution" Grid.Column="1"
                                  SelectionChanged="CboResolution_SelectionChanged"/>
                    </Grid>

                    <!-- FPS -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="FPS"
                                   Foreground="#F0F0F0"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                        <UniformGrid Grid.Column="1" Rows="1" Columns="3" Height="34">
                            <Button x:Name="BtnFps30"  Content="30 fps" Tag="30"
                                    Margin="0,0,6,0"
                                    Style="{StaticResource FpsBtnSelected}"
                                    Click="BtnFps_Click"/>
                            <Button x:Name="BtnFps60"  Content="60 fps" Tag="60"
                                    Margin="0,0,6,0"
                                    Style="{StaticResource FpsBtn}"
                                    Click="BtnFps_Click"/>
                            <Button x:Name="BtnFps120" Content="120 fps" Tag="120"
                                    Style="{StaticResource FpsBtn}"
                                    Click="BtnFps_Click"/>
                        </UniformGrid>
                    </Grid>

                    <TextBlock Margin="0,12,0,0"
                               Foreground="#444444"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="FPS alto e resolução alta exigem mais largura de banda."/>
                </StackPanel>
            </Border>

            <!-- Rodapé -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="Cancelar"
                        Style="{StaticResource BtnSecondary}"
                        Padding="14,8"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"/>

                <Button x:Name="BtnConfirm"
                        Grid.Column="2"
                        Content="Iniciar"
                        IsEnabled="False"
                        Style="{StaticResource BtnPrimary}"
                        Padding="18,8"
                        Click="Confirm_Click"/>
            </Grid>

        </StackPanel>
    </Border>
</Window>
