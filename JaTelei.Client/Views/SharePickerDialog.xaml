<Window x:Class="JaTelei.Client.Views.SharePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Escolher compartilhamento"
        Width="720" Height="640" MinHeight="560" MaxHeight="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        Foreground="#F0F0F0"
        FontFamily="Segoe UI"
        WindowStyle="None">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <Style x:Key="TypeBtn" TargetType="Button">
            <Setter Property="Background" Value="#10191D"/>
            <Setter Property="Foreground" Value="#9CABAF"/>
            <Setter Property="BorderBrush" Value="#2A3940"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="84"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#22D3A6"/>
                                <Setter TargetName="Bd" Property="Background" Value="#132522"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TypeBtnSelected" TargetType="Button" BasedOn="{StaticResource TypeBtn}">
            <Setter Property="Background" Value="#12332D"/>
            <Setter Property="BorderBrush" Value="#22D3A6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style x:Key="FpsBtn" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="FpsBtnSelected" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#0D1519"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2A3940"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#EEF5F5"/>
                        <Setter Property="Background" Value="#0D1519"/>
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#12332D"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#12332D"/>
                                            <Setter Property="Foreground" Value="#58F0C3"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,0,30,0">
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" Foreground="#9CABAF" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
                            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0" Opacity="0"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" Placement="Bottom">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260" Background="#0D1519" BorderBrush="#2A3940" BorderThickness="1" CornerRadius="7" Margin="0,3,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#36505A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#22D3A6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#EEF5F5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>

    <Border Background="#0F181C" BorderBrush="#243136" BorderThickness="1" CornerRadius="8">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Escolher tela" Foreground="#FFFFFF" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Selecione o que sera transmitido para o visualizador." Foreground="#9CABAF" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Content="X" Style="{StaticResource BtnGhost}" Padding="8,5" Click="Cancel_Click"/>
            </Grid>

            <UniformGrid Grid.Row="1" Rows="1" Columns="3" Margin="0,0,0,14">
                <Button x:Name="BtnTela" Style="{StaticResource TypeBtn}" Margin="0,0,8,0" Click="BtnTela_Click">
                    <StackPanel>
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="Tela inteira" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnJanela" Style="{StaticResource TypeBtn}" Margin="4,0" Click="BtnJanela_Click">
                    <StackPanel>
                        <TextBlock Text="&#xE7C4;" FontFamily="Segoe MDL2 Assets" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="Janela" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnJogo" Style="{StaticResource TypeBtn}" Margin="8,0,0,0" Click="BtnJogo_Click">
                    <StackPanel>
                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="Jogo" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <Grid Grid.Row="2" MinHeight="190">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="230"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="ListPanel" Visibility="Collapsed" Background="#10191D" BorderBrush="#243136" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock x:Name="ListLabel" Text="Selecione:" Foreground="#9CABAF" FontSize="12" Margin="0,0,0,8"/>
                        <ListBox x:Name="ItemsList" MaxHeight="150" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ListItemStyle}" SelectionChanged="ItemsList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border x:Name="QualityPanel" Grid.Column="1" Visibility="Collapsed" Background="#10191D" BorderBrush="#243136" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Qualidade" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock Text="Resolucao" Foreground="#9CABAF" FontSize="11" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CboResolution" Style="{StaticResource DarkComboBox}" SelectionChanged="CboResolution_SelectionChanged"/>
                        <TextBlock Text="FPS" Foreground="#9CABAF" FontSize="11" Margin="0,12,0,5"/>
                        <UniformGrid Rows="1" Columns="2">
                            <Button x:Name="BtnFps30" Content="30 fps" Tag="30" Style="{StaticResource FpsBtnSelected}" Margin="0,0,5,0" Click="BtnFps_Click"/>
                            <Button x:Name="BtnFps60" Content="60 fps" Tag="60" Style="{StaticResource FpsBtn}" Margin="5,0,0,0" Click="BtnFps_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="PreviewPanel" Grid.Row="3" Visibility="Collapsed" Background="#071116" BorderBrush="#243136" BorderThickness="1" CornerRadius="8" Margin="0,14,0,0" Padding="12">
                <Grid>
                    <Image x:Name="PreviewImage" MaxHeight="150" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="PreviewLoading" Text="Carregando previa..." Foreground="#7F8D91" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Grid Grid.Row="4" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="Cancelar" Style="{StaticResource BtnSecondary}" Padding="16,9" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="BtnConfirm" Grid.Column="2" Content="Iniciar compartilhamento" IsEnabled="False" Style="{StaticResource BtnPrimary}" Padding="18,9" Click="Confirm_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
