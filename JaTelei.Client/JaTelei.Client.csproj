<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>JaTelei</AssemblyName>
    <Product>Já Telei Beta</Product>
    <Copyright>JaClipei</Copyright>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <RootNamespace>JaTelei.Client</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0</Version>
    <!-- Publica como EXE único e autocontido -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client"     Version="8.*" />
    <PackageReference Include="CommunityToolkit.Mvvm"                   Version="8.*" />
    <PackageReference Include="SIPSorcery"                              Version="6.*" />
    <PackageReference Include="SIPSorceryMedia.Windows"                 Version="6.*" />
    <PackageReference Include="System.Drawing.Common"                   Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.*" />
    <Resource Include="Resources\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- appsettings.json: valores padrão/placeholder — vai no repositório -->
    <EmbeddedResource Include="appsettings.json" />
    <!-- appsettings.local.json: valores reais — gitignored, gerado pelo CI via secrets -->
    <EmbeddedResource Include="appsettings.local.json" Condition="Exists('appsettings.local.json')" />
  </ItemGroup>
</Project>
