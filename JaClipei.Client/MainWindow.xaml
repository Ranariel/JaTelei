<Window x:Class="JaClipei.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:JaClipei.Client.Views"
        Title="Ja Clipei" Height="560" Width="820"
        Background="#181825" WindowStyle="None"
        AllowsTransparency="True" ResizeMode="CanResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="5"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de título customizada -->
        <Border Grid.Row="0" Background="#11111b">
            <Grid>
                <TextBlock Text="Ja Clipei" Foreground="#cdd6f4"
                           VerticalAlignment="Center" Margin="12,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="─" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="32" Background="Transparent" BorderThickness="0" Foreground="White"/>
                    <Button Content="✕" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="32" Background="Transparent" BorderThickness="0" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Conteúdo principal: troca entre Login e Friends -->
        <ContentControl Grid.Row="1" x:Name="MainContent"/>
    </Grid>
</Window>
