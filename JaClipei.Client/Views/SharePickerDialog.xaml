<Window x:Class="JaClipei.Client.Views.SharePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar Compartilhamento"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1e1e2e"
        Foreground="#cdd6f4">

    <Window.Resources>
        <Style x:Key="TypeBtn" TargetType="Button">
            <Setter Property="Background"   Value="#313244"/>
            <Setter Property="Foreground"   Value="#cdd6f4"/>
            <Setter Property="BorderBrush"  Value="#45475a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width"  Value="140"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#89b4fa"/>
                                <Setter TargetName="Bd" Property="Background"   Value="#45475a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#585b70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TypeBtnSelected" TargetType="Button" BasedOn="{StaticResource TypeBtn}">
            <Setter Property="Background"  Value="#1e3a5f"/>
            <Setter Property="BorderBrush" Value="#89b4fa"/>
            <Setter Property="Foreground"  Value="#89b4fa"/>
        </Style>

        <Style x:Key="ListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground"        Value="#cdd6f4"/>
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="Padding"           Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Margin="0,2">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#313244"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1e3a5f"/>
                                <Setter Property="Foreground" Value="#89b4fa"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">

        <!-- Título -->
        <TextBlock Text="O que deseja compartilhar?"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="#cdd6f4" Margin="0,0,0,20"/>

        <!-- Opções de tipo -->
        <UniformGrid Rows="1" Columns="3" HorizontalAlignment="Center">

            <Button x:Name="BtnTela"  Style="{StaticResource TypeBtn}"
                    Margin="6,0" Click="BtnTela_Click">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🖥️" FontSize="28" HorizontalAlignment="Center"/>
                    <TextBlock Text="Tela"    Margin="0,6,0,0" HorizontalAlignment="Center"
                               FontWeight="Medium"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnJanela" Style="{StaticResource TypeBtn}"
                    Margin="6,0" Click="BtnJanela_Click">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🪟" FontSize="28" HorizontalAlignment="Center"/>
                    <TextBlock Text="Janela" Margin="0,6,0,0" HorizontalAlignment="Center"
                               FontWeight="Medium"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnJogo"  Style="{StaticResource TypeBtn}"
                    Margin="6,0" Click="BtnJogo_Click">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🎮" FontSize="28" HorizontalAlignment="Center"/>
                    <TextBlock Text="Jogo"   Margin="0,6,0,0" HorizontalAlignment="Center"
                               FontWeight="Medium"/>
                </StackPanel>
            </Button>

        </UniformGrid>

        <!-- Lista de seleção (Janela / Jogo / Monitor) -->
        <Border x:Name="ListPanel" Visibility="Collapsed"
                Background="#181825" CornerRadius="8"
                Margin="0,20,0,0" Padding="12">
            <StackPanel>
                <TextBlock x:Name="ListLabel"
                           Text="Selecione a janela:"
                           Foreground="#a6adc8" FontSize="12"
                           Margin="0,0,0,8"/>
                <ListBox x:Name="ItemsList"
                         MaxHeight="220"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource ListItemStyle}"
                         SelectionChanged="ItemsList_SelectionChanged"/>
            </StackPanel>
        </Border>

        <!-- Rodapé -->
        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="Cancelar"
                    Padding="16,8" Margin="0,0,8,0"
                    Background="#313244" Foreground="#cdd6f4"
                    BorderBrush="#45475a" BorderThickness="1"
                    Click="Cancel_Click"/>

            <Button x:Name="BtnConfirm" Grid.Column="2"
                    Content="Iniciar" IsEnabled="False"
                    Padding="20,8"
                    Background="#89b4fa" Foreground="#1e1e2e"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Click="Confirm_Click"/>
        </Grid>
    </StackPanel>
</Window>
