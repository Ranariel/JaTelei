<UserControl x:Class="JaClipei.Client.Views.FriendsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1e1e2e">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Painel esquerdo: lista de amigos -->
        <DockPanel Grid.Column="0" Background="#1e1e2e">
            <!-- Adicionar amigo -->
            <StackPanel DockPanel.Dock="Top" Margin="8">
                <TextBlock Text="Amigos" Foreground="White" FontSize="14"
                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Tag="Apelido do amigo"
                             Background="#313244" Foreground="#cdd6f4"
                             CaretBrush="White" BorderBrush="#45475a" Padding="6,4"
                             Text="{Binding AddUsername, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1" Content="+" Margin="4,0,0,0"
                            Background="#89b4fa" Foreground="#1e1e2e" FontWeight="Bold"
                            Command="{Binding AddFriendCommand}"/>
                </Grid>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#a6e3a1"
                           FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Pedidos pendentes -->
            <ItemsControl DockPanel.Dock="Top"
                          ItemsSource="{Binding PendingRequests}"
                          Visibility="{Binding PendingRequests.Count, Converter={StaticResource CountToVis}}"
                          Margin="8,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#313244" CornerRadius="4" Margin="0,2" Padding="6">
                            <Grid>
                                <TextBlock Text="{Binding Username}" Foreground="#cdd6f4"/>
                                <Button Content="\u2713" HorizontalAlignment="Right"
                                        Command="{Binding DataContext.AcceptRequestCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Lista de amigos -->
            <ListBox ItemsSource="{Binding Friends}"
                     SelectedItem="{Binding SelectedFriend}"
                     Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#6c7086"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                <Setter Property="Fill" Value="#a6e3a1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding Username}" Foreground="#cdd6f4"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Painel direito -->
        <Grid Grid.Column="1" Background="#181825">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Selecione um amigo e clique em Compartilhar"
                           Foreground="#6c7086" FontSize="14" TextWrapping="Wrap"
                           TextAlignment="Center" MaxWidth="260"
                           Visibility="{Binding SelectedFriend, Converter={StaticResource NullToVis}}"/>

                <StackPanel Visibility="{Binding SelectedFriend, Converter={StaticResource NotNullToVis}}">
                    <TextBlock FontSize="16" Foreground="White" TextAlignment="Center"
                               Margin="0,0,0,16">
                        <Run Text="Compartilhar com "/>
                        <Run Text="{Binding SelectedFriend.Username}" FontWeight="Bold"/>
                    </TextBlock>
                    <Button Content="&#x25BA;  Iniciar compartilhamento"
                            Command="{Binding ShareScreenCommand}"
                            Background="#89b4fa" Foreground="#1e1e2e"
                            Padding="16,8" FontSize="14"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
