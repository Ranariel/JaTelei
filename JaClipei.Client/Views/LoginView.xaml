<UserControl x:Class="JaClipei.Client.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JaClipei.Client.ViewModels"
             Background="#1e1e2e">
    <Grid Background="#cc0000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="JA CLIPEI - TESTE RENDER"
                   FontSize="28" FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,40,0,20"/>

        <TextBox Grid.Row="1" Margin="40,4"
                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                 Background="White" Foreground="Black"
                 Padding="8,6"/>

        <PasswordBox Grid.Row="2" Margin="40,4"
                     Background="White" Foreground="Black"
                     Padding="8,6"
                     x:Name="PwdBox"/>

        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}"
                   Foreground="Yellow" Margin="40,4" TextWrapping="Wrap"/>

        <Button Grid.Row="4" Margin="40,12" Padding="0,12"
                Background="#0078d4" Foreground="White"
                FontSize="16" FontWeight="Bold"
                BorderThickness="0"
                Command="{Binding SubmitCommand}">
            <TextBlock Text="ENTRAR"/>
        </Button>
    </Grid>
</UserControl>
