<UserControl x:Class="JaClipei.Client.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JaClipei.Client.ViewModels">
    <Grid MaxWidth="340" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Ja Clipei" FontSize="28" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Somente no modo registro -->
        <TextBox Grid.Row="1" Margin="0,4"
                 Tag="Apelido (ex: gamer123)"
                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                 Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}"/>

        <TextBox Grid.Row="2" Margin="0,4"
                 Tag="Email"
                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

        <PasswordBox Grid.Row="3" Margin="0,4"
                     x:Name="PwdBox"/>

        <TextBlock Grid.Row="4" Text="{Binding ErrorMessage}"
                   Foreground="Red" Margin="0,4" TextWrapping="Wrap"/>

        <Button Grid.Row="5" Margin="0,8"
                Command="{Binding SubmitCommand}"
                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}">
            <TextBlock Text="{Binding IsRegisterMode, Converter={StaticResource BoolToLoginRegister}}"/>
        </Button>

        <Button Grid.Row="6" Command="{Binding ToggleModeCommand}"
                Background="Transparent" BorderThickness="0">
            <TextBlock>
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Não tem conta? Criar agora"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                                <Setter Property="Text" Value="Já tem conta? Entrar"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Button>
    </Grid>
</UserControl>
